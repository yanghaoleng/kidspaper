{
  "name": "kidspaper",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:workplace": "vite --mode workplace --host 127.0.0.1",
    "server:workplace": "APP_EDITION=workplace PORT=4318 node --env-file=.env server/index.mjs",
    "build:workplace": "vite build --mode workplace && esbuild server/index.mjs --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/server.cjs",
    "server": "node --env-file=.env server/index.mjs",
    "build": "vite build && esbuild server/index.mjs --bundle --platform=node --target=node18 --format=cjs --outfile=dist-server/server.cjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server shared tests vite.config.js"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "d3-geo": "^3.1.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "vite": "^6.4.4"
  }
}
